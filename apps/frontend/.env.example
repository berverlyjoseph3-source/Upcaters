# enterprise-ai-agent-platform/apps/frontend/.env.example

# API Configuration
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# Stripe Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx

# App Configuration
VITE_APP_NAME=AI Agent Platform
VITE_APP_DESCRIPTION=Enterprise AI Agent Platform

# Analytics (optional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (optional)
VITE_SENTRY_DSN=https://xxxxxxxx@oxxxxxx.ingest.sentry.io/xxxxxx

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_BILLING=true
VITE_ENABLE_ADMIN=true

# Environment
VITE_ENVIRONMENT=development