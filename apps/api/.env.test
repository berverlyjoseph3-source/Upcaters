# enterprise-ai-agent-platform/apps/api/.env.test
# Test Environment Variables

# ============================================
# Application Configuration
# ============================================
NODE_ENV=test
PORT=3001
APP_URL=http://localhost:3001
LOG_LEVEL=error

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://testuser:testpass@localhost:5432/aiagent_test
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=5

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/1
REDIS_KEY_PREFIX=aiagent:test:

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_URL=mongodb://localhost:27017/aiagent_test

# ============================================
# JWT Configuration (Test Keys)
# ============================================
JWT_SECRET=test_jwt_secret_key_32_chars_long
JWT_REFRESH_SECRET=test_refresh_secret_key_32_chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ============================================
# OAuth Configuration (Mock)
# ============================================
GOOGLE_CLIENT_ID=mock_google_client_id
GOOGLE_CLIENT_SECRET=mock_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

LINKEDIN_CLIENT_ID=mock_linkedin_client_id
LINKEDIN_CLIENT_SECRET=mock_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3001/api/auth/linkedin/callback

FACEBOOK_APP_ID=mock_facebook_app_id
FACEBOOK_APP_SECRET=mock_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3001/api/auth/facebook/callback

TWITTER_API_KEY=mock_twitter_api_key
TWITTER_API_SECRET=mock_twitter_api_secret
TWITTER_ACCESS_TOKEN=mock_twitter_access_token
TWITTER_ACCESS_SECRET=mock_twitter_access_secret
TWITTER_BEARER_TOKEN=mock_twitter_bearer_token

# ============================================
# AI Services (Mock)
# ============================================
OPENAI_API_KEY=mock_openai_key
ANTHROPIC_API_KEY=mock_anthropic_key
GOOGLE_AI_API_KEY=mock_google_ai_key

# ============================================
# Web Search (Mock)
# ============================================
BRAVE_SEARCH_API_KEY=mock_brave_key
OPENWEATHERMAP_API_KEY=mock_weather_key
PERPLEXITY_API_KEY=mock_perplexity_key

# ============================================
# Task Management (Mock)
# ============================================
ASANA_ACCESS_TOKEN=mock_asana_token
MONDAY_API_KEY=mock_monday_key

# ============================================
# Stripe (Test Keys)
# ============================================
STRIPE_SECRET_KEY=sk_test_mock_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_mock_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_mock_publishable_key

# ============================================
# Email (Mock)
# ============================================
SENDGRID_API_KEY=SG.mock_sendgrid_key
FROM_EMAIL=test@aiagentplatform.com
FROM_NAME=AI Agent Platform Test

# ============================================
# AWS (Mock)
# ============================================
AWS_ACCESS_KEY_ID=mock_aws_key
AWS_SECRET_ACCESS_KEY=mock_aws_secret
AWS_REGION=us-east-1
AWS_S3_BUCKET=ai-agent-platform-test

# ============================================
# Rate Limiting (Disabled for tests)
# ============================================
RATE_LIMIT_ENABLED=false

# ============================================
# Feature Flags (Test)
# ============================================
ENABLE_VIDEO_GENERATION=false
ENABLE_WHITE_LABEL=false
ENABLE_CUSTOM_INTEGRATIONS=false
ENABLE_MAINTENANCE_MODE=false
ENABLE_EMAIL_VERIFICATION=false

# ============================================
# Jest Configuration
# ============================================
JEST_TIMEOUT=30000
JEST_MAX_WORKERS=50%