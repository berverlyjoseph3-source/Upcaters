# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Environment (development, staging, production)
NODE_ENV=development

# Server Configuration
PORT=3000
API_URL=http://localhost:3000
APP_URL=http://localhost:3001

# Logging Level (debug, info, warn, error)
LOG_LEVEL=debug

# Build Information
BUILD_NUMBER=1

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL (Primary Database)
DATABASE_URL=postgresql://aiagent_user:changeme123@localhost:5432/aiagent
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT=10000
DATABASE_CONNECTION_TIMEOUT=5000

# Redis (Cache, Queues, Sessions, Rate Limiting) - REQUIRED for production
REDIS_URL=redis://:changeme123@localhost:6379
REDIS_PASSWORD=changeme123
REDIS_TLS=false
REDIS_KEY_PREFIX=aiagent:
REDIS_MAX_RETRIES=3
REDIS_RETRY_DELAY_MS=1000

# MongoDB (Vector Storage, Agent Memory)
MONGODB_URL=mongodb://admin:changeme123@localhost:27017/aiagent
MONGODB_REPLICA_SET=rs0
MONGODB_SSL=false

# ============================================
# JWT & SECURITY
# ============================================

# JWT Secrets (Generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_32_chars_minimum_here_123456
JWT_REFRESH_SECRET=your_refresh_secret_32_chars_minimum_here_789012
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Encryption Key for OAuth Tokens (32 bytes hex, generate with: openssl rand -hex 32)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Password Security
BCRYPT_ROUNDS=12

# Session Configuration
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=30
MAX_CONCURRENT_SESSIONS=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTHENTICATED_MAX=1000
RATE_LIMIT_API_KEY_MAX=2000

# ============================================
# AI SERVICES (LLM PROVIDERS) - Enhanced with Fallback Chain
# ============================================

# AI Provider Fallback Configuration
# Comma-separated list: openai,anthropic,google
# The system will try providers in this order
AI_PROVIDER_FALLBACK_CHAIN=openai,anthropic,google
DEFAULT_AI_MODEL=gpt-4-turbo-preview
MODEL_FALLBACK_ENABLED=true
MODEL_FALLBACK_CHAIN=openai,anthropic,gemini

# OpenAI - GPT-4, GPT-3.5, DALL-E, Embeddings
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
OPENAI_ORG_ID=org-your_organization_id_here
OPENAI_TIMEOUT=30000
OPENAI_MAX_RETRIES=3

# Anthropic - Claude 3 Models
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_api_key_here
ANTHROPIC_TIMEOUT=60000
ANTHROPIC_MAX_RETRIES=3

# Google Gemini / Google AI
# Get your API key from: https://aistudio.google.com/
GOOGLE_AI_API_KEY=AIzaSyYourGoogleApiKeyHere
GOOGLE_AI_TIMEOUT=30000
GOOGLE_AI_MAX_RETRIES=3

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_CACHE_TTL=3600
EMBEDDING_BATCH_SIZE=10

# ============================================
# OAUTH INTEGRATIONS
# ============================================

# Google OAuth (Gmail, Drive, Calendar, Tasks)
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# LinkedIn OAuth
# Create app at: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/linkedin/callback

# Facebook OAuth
# Create app at: https://developers.facebook.com/apps/
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/auth/facebook/callback

# X (Twitter) OAuth 2.0
# Create app at: https://developer.twitter.com/
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_REDIRECT_URI=http://localhost:3000/api/auth/twitter/callback
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAyour_bearer_token

# Microsoft 365 (Outlook, OneDrive, SharePoint)
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# ============================================
# WEB SEARCH & RESEARCH
# ============================================

# Brave Search API
# Get key from: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=BSAyour_brave_search_api_key

# OpenWeatherMap API
# Get key from: https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key

# Perplexity AI - Deep Research
# Get key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-your_perplexity_api_key

# ============================================
# TASK MANAGEMENT INTEGRATIONS
# ============================================

# Asana (Task Management)
# Get token from: https://app.asana.com/0/developer-console
ASANA_ACCESS_TOKEN=1/your_asana_access_token

# Monday.com
# Get token from: https://developer.monday.com/apps/
MONDAY_API_KEY=eyJhbGciOiJIUzI1NiJ9.your_monday_api_key

# ============================================
# STRIPE PAYMENT PROCESSING - Updated 2025 Pricing
# ============================================

# Stripe API Keys
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_API_VERSION=2024-12-18.acacia

# Stripe Price IDs - Updated Pricing (2025)
# Starter: $39/month ($374.40/year - 20% off)
STRIPE_STARTER_MONTHLY_PRICE_ID=price_starter_39_monthly
STRIPE_STARTER_YEARLY_PRICE_ID=price_starter_374_yearly

# Professional: $129/month ($1,238.40/year - 20% off)
STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=price_professional_129_monthly
STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=price_professional_1238_yearly

# Enterprise: $599/month ($5,750.40/year - 20% off)
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_enterprise_599_monthly
STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_enterprise_5750_yearly

# Usage-based Overage Prices (Metered Billing)
STRIPE_AI_ACTIONS_OVERAGE_PRICE_ID=price_ai_actions_overage
STRIPE_API_CALLS_OVERAGE_PRICE_ID=price_api_calls_overage
STRIPE_IMAGE_OVERAGE_PRICE_ID=price_image_overage
STRIPE_VIDEO_OVERAGE_PRICE_ID=price_video_overage

# Stripe Usage Reporting
STRIPE_USAGE_REPORTING_ENABLED=true
STRIPE_USAGE_REPORTING_INTERVAL=86400

# ============================================
# EMAIL SERVICE
# ============================================

# SendGrid (Primary email provider)
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key
FROM_EMAIL=noreply@aiagentplatform.com
FROM_NAME=AI Agent Platform

# SMTP (Fallback email provider)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# Email Notifications
USAGE_WARNING_EMAIL_ENABLED=true
USAGE_CRITICAL_EMAIL_ENABLED=true
WEEKLY_DIGEST_ENABLED=true

# ============================================
# MONITORING & ERROR TRACKING
# ============================================

# Sentry (Error tracking)
# Get DSN from: https://sentry.io/settings/
SENTRY_DSN=https://your_sentry_dsn@o123456.ingest.sentry.io/1234567
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=development

# DataDog (Performance monitoring)
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# Prometheus (Metrics collection)
PROMETHEUS_ENABLED=true

# ============================================
# ORCHESTRATOR CONFIGURATION - Enhanced
# ============================================

# Execution Control
MAX_CONCURRENT_EXECUTIONS=10
EXECUTION_TIMEOUT_MS=300000
DEFAULT_STEP_TIMEOUT_MS=30000
MAX_STEPS_PER_PLAN=10
MAX_RETRIES_PER_STEP=3
MAX_PLAN_RETRIES=2

# Retry Configuration
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=30000
RETRY_MULTIPLIER=2

# Circuit Breaker
ENABLE_CIRCUIT_BREAKER=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_MS=60000

# Backpressure Control
ENABLE_BACKPRESSURE=true
MAX_PENDING_EXECUTIONS=100

# Memory Management
ENABLE_MEMORY_CONSOLIDATION=true
ENABLE_VECTOR_SEARCH=true
MAX_SHORT_TERM_MEMORIES=50
SHORT_TERM_TTL_SECONDS=3600
LONG_TERM_IMPORTANCE_THRESHOLD=0.7

# Pre-Execution Checks
ENABLE_PRE_EXECUTION_COST_CHECK=true
ENABLE_PLAN_OPTIMIZATION=true
ENABLE_AUTOMATIC_FALLBACKS=true

# Execution Persistence
ENABLE_EXECUTION_PERSISTENCE=true
PERSISTENCE_CLEANUP_DAYS=7

# Streaming
ENABLE_STREAMING=true
STREAMING_CHUNK_DELAY_MS=50
MAX_CHUNK_SIZE=200

# Reflection
ENABLE_EXECUTION_REFLECTION=true
REFLECTION_MODEL=gpt-4-turbo-preview

# Orchestrator Rate Limiting
ORCHESTRATOR_REQUESTS_PER_MINUTE=60
ORCHESTRATOR_TOKENS_PER_MINUTE=90000
ORCHESTRATOR_COST_PER_HOUR=50

# ============================================
# INTENT CLASSIFIER CONFIGURATION - Enhanced
# ============================================

# Learning & Caching
ENABLE_INTENT_LEARNING=true
INTENT_CONFIDENCE_THRESHOLD=0.6
INTENT_MAX_ALTERNATIVES=3
INTENT_CACHE_TTL=3600
INTENT_CACHE_ENABLED=true
INTENT_CLASSIFICATION_METHOD=auto

# Ambiguity Detection
INTENT_AMBIGUITY_DETECTION=true
INTENT_MULTI_INTENT_DETECTION=true

# Correction Learning
MAX_CORRECTION_HISTORY=1000
CORRECTION_LEARNING_ENABLED=true
CORRECTION_SIMILARITY_THRESHOLD=0.7

# ============================================
# MEMORY MANAGER CONFIGURATION - Enhanced
# ============================================

# Memory Features
ENABLE_MEMORY_DEDUPLICATION=true
ENABLE_MEMORY_COMPRESSION=true
ENABLE_MEMORY_RELATIONSHIPS=true

# Memory Performance
MEMORY_DEDUPLICATION_THRESHOLD=0.85
MEMORY_COMPRESSION_THRESHOLD=1000
MAX_HYBRID_SEARCH_RESULTS=20
HYBRID_SEARCH_WEIGHT=0.6

# ============================================
# USAGE LIMITS (PER PLAN) - Updated 2025
# ============================================

# Free Plan - $0/month
AI_ACTIONS_LIMIT_FREE=50
API_CALLS_LIMIT_FREE=100
TEAM_MEMBERS_LIMIT_FREE=1
STORAGE_GB_LIMIT_FREE=0.1

# Starter Plan - $39/month
AI_ACTIONS_LIMIT_STARTER=500
API_CALLS_LIMIT_STARTER=2000
TEAM_MEMBERS_LIMIT_STARTER=3
STORAGE_GB_LIMIT_STARTER=1

# Professional Plan - $129/month
AI_ACTIONS_LIMIT_PROFESSIONAL=2500
API_CALLS_LIMIT_PROFESSIONAL=15000
TEAM_MEMBERS_LIMIT_PROFESSIONAL=10
STORAGE_GB_LIMIT_PROFESSIONAL=10

# Enterprise Plan - $599/month (Soft caps with overage pricing)
AI_ACTIONS_LIMIT_ENTERPRISE=10000
API_CALLS_LIMIT_ENTERPRISE=50000
TEAM_MEMBERS_LIMIT_ENTERPRISE=100
STORAGE_GB_LIMIT_ENTERPRISE=100

# Default Plan
DEFAULT_PLAN=FREE
TRIAL_DAYS=14

# ============================================
# OVERAGE PRICING (PER PLAN)
# ============================================

# Starter Plan Overage Rates
OVERAGE_AI_ACTION_STARTER=0.05
OVERAGE_API_CALL_STARTER=0.01
OVERAGE_IMAGE_STARTER=0.10
OVERAGE_VIDEO_STARTER=1.00

# Professional Plan Overage Rates
OVERAGE_AI_ACTION_PROFESSIONAL=0.05
OVERAGE_API_CALL_PROFESSIONAL=0.01
OVERAGE_IMAGE_PROFESSIONAL=0.10
OVERAGE_VIDEO_PROFESSIONAL=1.00

# Enterprise Plan Overage Rates (Discounted)
OVERAGE_AI_ACTION_ENTERPRISE=0.02
OVERAGE_API_CALL_ENTERPRISE=0.005
OVERAGE_IMAGE_ENTERPRISE=0.05
OVERAGE_VIDEO_ENTERPRISE=0.50

# ============================================
# ACTION COSTS (in units)
# ============================================

# Email Agent
ACTION_COST_EMAIL_PROCESS=1
ACTION_COST_EMAIL_REPLY=2
ACTION_COST_EMAIL_SEND=1
ACTION_COST_EMAIL_FETCH=1

# Drive Agent
ACTION_COST_DRIVE_UPLOAD=2
ACTION_COST_DRIVE_DOWNLOAD=1
ACTION_COST_DRIVE_SEARCH=0.5

# Content Agent
ACTION_COST_CONTENT_TEXT=3
ACTION_COST_CONTENT_IMAGE=5
ACTION_COST_CONTENT_VIDEO=20
ACTION_COST_CONTENT_ANALYZE=2

# Social Agent
ACTION_COST_SOCIAL_POST=1
ACTION_COST_SOCIAL_SCHEDULE=0.5
ACTION_COST_SOCIAL_ANALYTICS=1

# Calendar Agent
ACTION_COST_CALENDAR_GET=0.5
ACTION_COST_CALENDAR_CREATE=1
ACTION_COST_CALENDAR_UPDATE=1
ACTION_COST_CALENDAR_SCHEDULE=1

# Web Agent
ACTION_COST_WEB_SEARCH=1
ACTION_COST_WEB_SCRAPE=2
ACTION_COST_WEATHER=0.5

# Task Agent
ACTION_COST_TASK_CREATE=0.5
ACTION_COST_TASK_UPDATE=0.5
ACTION_COST_TASK_LIST=0.5

# Orchestrator
ACTION_COST_ORCHESTRATOR_PARSE=3
ACTION_COST_ORCHESTRATOR_ROUTE=1

# Token Multipliers (cost per 1000 tokens)
TOKEN_MULTIPLIER_EMAIL=0.001
TOKEN_MULTIPLIER_CONTENT=0.002
TOKEN_MULTIPLIER_ORCHESTRATOR=0.002

# ============================================
# CRON JOB SCHEDULES
# ============================================

# Billing & Usage
BILLING_RESET_CRON=0 0 1 * *
WEEKLY_DIGEST_CRON=0 9 * * 1
DAILY_SYNC_CRON=0 2 * * *

# Cleanup Jobs
CLEANUP_CRON=0 3 * * 0
MEMORY_CONSOLIDATION_CRON=0 */2 * * *
EMBEDDING_BATCH_CRON=*/30 * * * *

# Usage Reporting
STRIPE_USAGE_REPORTING_CRON=0 0 * * *
USAGE_RESET_CRON=0 0 1 * *

# ============================================
# CACHE CONFIGURATION
# ============================================

# Cache TTL (seconds)
USAGE_CACHE_TTL=3600
PLAN_CACHE_TTL=300
USER_CACHE_TTL=1800
AGENT_CACHE_TTL=600
SESSION_CACHE_TTL=86400
INTENT_CACHE_TTL=3600
EMBEDDING_CACHE_TTL=3600

# ============================================
# NOTIFICATION SETTINGS
# ============================================

# Email Notifications
USAGE_WARNING_EMAIL_ENABLED=true
USAGE_CRITICAL_EMAIL_ENABLED=true
WEEKLY_DIGEST_ENABLED=true
DAILY_DIGEST_ENABLED=true

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/slack/webhook

# Webhook Notifications
NOTIFICATION_WEBHOOK_URL=https://your-webhook-url.com/notifications

# ============================================
# FEATURE FLAGS - Enhanced
# ============================================

# Core Features
ENABLE_REGISTRATION=true
ENABLE_MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Platform under maintenance. Please check back later.

# Agent Features
ENABLE_VIDEO_GENERATION=false
ENABLE_WHITE_LABEL=false
ENABLE_CUSTOM_INTEGRATIONS=false

# AI Features
ENABLE_AI_CONTENT_MODERATION=true
ENABLE_AI_IMAGE_GENERATION=true
ENABLE_AI_VIDEO_GENERATION=false

# Security Features
ENABLE_EMAIL_VERIFICATION=false
ENABLE_TWO_FACTOR=false
ENABLE_API_RATE_LIMITING=true
ENABLE_CSRF_PROTECTION=true

# Orchestrator Features
ENABLE_ORCHESTRATOR=true
ENABLE_EXECUTION_LOGGING=true
ENABLE_PERFORMANCE_METRICS=true

# Billing Features
ENABLE_BILLING=true
ENABLE_OVERAGE_TRACKING=true
ENABLE_UPGRADE_RECOMMENDATIONS=true

# Analytics
ENABLE_ANALYTICS=true
ENABLE_USAGE_FORECASTING=true

# Debug
ENABLE_DEBUG_MODE=false
DEBUG_NAMESPACE=ai-agent:*
ENABLE_API_DOCS=true

# ============================================
# CORS & SECURITY HEADERS
# ============================================

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3001,https://app.aiagentplatform.com
TRUST_PROXY=false

# ============================================
# DATA RETENTION
# ============================================

# Days to keep data
USAGE_REPORT_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
AGENT_MEMORY_RETENTION_DAYS=180
WEBHOOK_EVENT_RETENTION_DAYS=30
PERSISTENCE_CLEANUP_DAYS=7

# ============================================
# DEVELOPMENT ONLY
# ============================================

# Mock external services (development only)
MOCK_EXTERNAL_APIS=false
MOCK_EMAIL_SERVICE=false
MOCK_PAYMENT_SERVICE=false

# Seed database with sample data
SEED_DATABASE=true

# Debug mode
DEBUG=true
DEBUG_NAMESPACE=ai-agent:*

# Enable swagger/API documentation
ENABLE_API_DOCS=true

# ============================================
# TESTING (CI/CD Pipeline)
# ============================================

# Test Database
TEST_DATABASE_URL=postgresql://testuser:testpass@localhost:5432/aiagent_test
TEST_REDIS_URL=redis://localhost:6379/1
TEST_MONGODB_URL=mongodb://localhost:27017/aiagent_test

# Test Configuration
JEST_TIMEOUT=30000
JEST_MAX_WORKERS=50%

