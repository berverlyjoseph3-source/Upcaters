# enterprise-ai-agent-platform/apps/api/.env.production.example
# Production Environment Variables

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
PORT=3000
APP_URL=https://api.aiagentplatform.com
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://aiagent_user:${DB_PASSWORD}@${DB_HOST}:5432/aiagent
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT=30000
DATABASE_CONNECTION_TIMEOUT=5000

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=rediss://:${REDIS_PASSWORD}@${REDIS_HOST}:6379
REDIS_TLS=true
REDIS_KEY_PREFIX=aiagent:prod:

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_URL=mongodb://${MONGO_USER}:${MONGO_PASSWORD}@${MONGO_HOST}:27017/aiagent
MONGODB_REPLICA_SET=rs0
MONGODB_SSL=true

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=<32-char-random-secret>
  JWT_REFRESH_SECRET=<32-char-random-secret>
    JWT_ACCESS_EXPIRY=15m
    JWT_REFRESH_EXPIRY=30d
    ENCRYPTION_KEY=<32-byte-hex-key>
    
      # ============================================
      # OAuth Configuration
      # ============================================
      # Google
      GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
      GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
      GOOGLE_REDIRECT_URI=https://api.aiagentplatform.com/api/auth/google/callback
      
      # LinkedIn
      LINKEDIN_CLIENT_ID=xxxxxxxxxxxx
      LINKEDIN_CLIENT_SECRET=xxxxxxxxxxxx
      LINKEDIN_REDIRECT_URI=https://api.aiagentplatform.com/api/auth/linkedin/callback
      
      # Facebook
      FACEBOOK_APP_ID=xxxxxxxxxxxx
      FACEBOOK_APP_SECRET=xxxxxxxxxxxx
      FACEBOOK_REDIRECT_URI=https://api.aiagentplatform.com/api/auth/facebook/callback
      
      # X (Twitter)
      TWITTER_API_KEY=xxxxxxxxxxxx
      TWITTER_API_SECRET=xxxxxxxxxxxx
      TWITTER_ACCESS_TOKEN=xxxxxxxxxxxx
      TWITTER_ACCESS_SECRET=xxxxxxxxxxxx
      TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAA
      
      # ============================================
      # AI Services Configuration
      # ============================================
      # OpenAI
      OPENAI_API_KEY=sk-proj-xxxxxxxxxxxx
      OPENAI_ORG_ID=org-xxxxxxxxxxxx
      OPENAI_TIMEOUT=30000
      OPENAI_MAX_RETRIES=3
      
      # Anthropic
      ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxx
      ANTHROPIC_TIMEOUT=60000
      
      # Google Gemini
      GOOGLE_AI_API_KEY=AIzaSyxxxxxxxxxxxx
      GOOGLE_AI_TIMEOUT=30000
      
      # ============================================
      # Web Search Configuration
      # ============================================
      BRAVE_SEARCH_API_KEY=BSAxxxxxxxxxxxx
      OPENWEATHERMAP_API_KEY=xxxxxxxxxxxx
      PERPLEXITY_API_KEY=pplx-xxxxxxxxxxxx
      
      # ============================================
      # Task Management APIs
      # ============================================
      ASANA_ACCESS_TOKEN=1/xxxxxxxxxxxx
      MONDAY_API_KEY=eyJhbGciOiJIUzI1NiJ9
      
      # ============================================
      # Stripe Configuration
      # ============================================
      STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
      STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
      STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
      STRIPE_API_VERSION=2024-12-18.acacia
      
      # Stripe Price IDs
      STRIPE_STARTER_MONTHLY_PRICE_ID=price_xxxxxxxxxxxx
      STRIPE_STARTER_YEARLY_PRICE_ID=price_xxxxxxxxxxxx
      STRIPE_PROFESSIONAL_MONTHLY_PRICE_ID=price_xxxxxxxxxxxx
      STRIPE_PROFESSIONAL_YEARLY_PRICE_ID=price_xxxxxxxxxxxx
      STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_xxxxxxxxxxxx
      STRIPE_ENTERPRISE_YEARLY_PRICE_ID=price_xxxxxxxxxxxx
      
      # ============================================
      # Email Configuration
      # ============================================
      # SendGrid
      SENDGRID_API_KEY=SG.xxxxxxxxxxxx
      FROM_EMAIL=noreply@aiagentplatform.com
      FROM_NAME=AI Agent Platform
      
      # SMTP (fallback)
      SMTP_HOST=smtp.sendgrid.net
      SMTP_PORT=587
      SMTP_USER=apikey
      SMTP_PASS=SG.xxxxxxxxxxxx
      SMTP_SECURE=false
      
      # ============================================
      # AWS Configuration
      # ============================================
      AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxx
      AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxx
      AWS_REGION=us-east-1
      AWS_S3_BUCKET=ai-agent-platform-storage-prod
      AWS_S3_PUBLIC_URL=https://cdn.aiagentplatform.com
      AWS_CLOUDFRONT_KEY_PAIR_ID=xxxxxxxxxxxx
      AWS_CLOUDFRONT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----
      
      # ============================================
      # Rate Limiting
      # ============================================
      RATE_LIMIT_WINDOW_MS=60000
      RATE_LIMIT_MAX_REQUESTS=100
      RATE_LIMIT_AUTHENTICATED_MAX=1000
      RATE_LIMIT_API_KEY_MAX=2000
      
      # ============================================
      # Usage Limits
      # ============================================
      AI_ACTIONS_LIMIT_FREE=50
      AI_ACTIONS_LIMIT_STARTER=500
      AI_ACTIONS_LIMIT_PROFESSIONAL=2500
      API_CALLS_LIMIT_FREE=100
      API_CALLS_LIMIT_STARTER=2000
      API_CALLS_LIMIT_PROFESSIONAL=15000
      
      # ============================================
      # Cron Jobs
      # ============================================
      DAILY_DIGEST_CRON=0 8 * * *
      WEEKLY_REPORT_CRON=0 9 * * 1
      DAILY_SYNC_CRON=0 2 * * *
      CLEANUP_CRON=0 3 * * 0
      USAGE_RESET_CRON=0 0 1 * *
      
      # ============================================
      # Security
      # ============================================
      BCRYPT_ROUNDS=12
      SESSION_TIMEOUT_MINUTES=30
      MAX_LOGIN_ATTEMPTS=5
      PASSWORD_EXPIRY_DAYS=90
      TWO_FACTOR_REQUIRED=false
      
      # ============================================
      # Monitoring
      # ============================================
      SENTRY_DSN=https://xxxxxxxx@oxxxxxx.ingest.sentry.io/xxxxxx
      SENTRY_TRACES_SAMPLE_RATE=0.1
      DATADOG_API_KEY=xxxxxxxxxxxx
      DATADOG_APP_KEY=xxxxxxxxxxxx
      
      # ============================================
      # Feature Flags
      # ============================================
      ENABLE_VIDEO_GENERATION=true
      ENABLE_WHITE_LABEL=false
      ENABLE_CUSTOM_INTEGRATIONS=true
      ENABLE_MAINTENANCE_MODE=false
      
      # ============================================
      # Internal Configuration
      # ============================================
      TRUST_PROXY=true
      CORS_ORIGINS=https://app.aiagentplatform.com,https://staging.aiagentplatform.com
      CSRF_ENABLED=true
      HELMET_ENABLED=true
      COMPRESSION_ENABLED=true