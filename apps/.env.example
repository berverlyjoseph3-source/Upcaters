# enterprise-ai-agent-platform/apps/api/.env.example
# Add these to your existing .env.example file

# ============================================
# USAGE METERING & BILLING
# ============================================

# Redis Configuration (for usage counters)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password_here

# Stripe Configuration (for usage-based billing)
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_STARTER_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxxxxxxxxxxx

# Usage Alert Thresholds (percentage)
USAGE_WARNING_THRESHOLD=80
USAGE_CRITICAL_THRESHOLD=95

# Billing Period Configuration
BILLING_RESET_CRON=0 0 1 * * # 1st of each month at midnight
WEEKLY_DIGEST_CRON=0 9 * * 1 # Monday at 9 AM
DAILY_SYNC_CRON=0 2 * * * # Daily at 2 AM

# Report Retention (days)
USAGE_REPORT_RETENTION_DAYS=90
USAGE_LOG_RETENTION_DAYS=365

# Email Notifications
USAGE_WARNING_EMAIL_ENABLED=true
USAGE_CRITICAL_EMAIL_ENABLED=true
WEEKLY_DIGEST_ENABLED=true

# Redis Cache TTL (seconds)
USAGE_CACHE_TTL=3600
PLAN_CACHE_TTL=300

# Rate Limits (requests per minute)
RATE_LIMIT_UNAUTHENTICATED=100
RATE_LIMIT_AUTHENTICATED=1000
RATE_LIMIT_API_KEY=2000

# Action Costs (in units)
COST_EMAIL_PROCESS=1
COST_EMAIL_REPLY=2
COST_CONTENT_TEXT=3
COST_CONTENT_IMAGE=5
COST_CONTENT_VIDEO=20
COST_SOCIAL_POST=1
COST_WEB_SEARCH=1
COST_API_CALL=1

# Token Multipliers (cost per 1000 tokens)
TOKEN_MULTIPLIER_EMAIL=0.001
TOKEN_MULTIPLIER_CONTENT=0.002
TOKEN_MULTIPLIER_ORCHESTRATOR=0.002

# Stripe Usage Reporting
STRIPE_USAGE_REPORTING_ENABLED=true
STRIPE_USAGE_REPORTING_INTERVAL=86400 # 24 hours in seconds

# Admin Alert Webhook (for critical issues)
ADMIN_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/xxxxx/xxxxx/xxxxx