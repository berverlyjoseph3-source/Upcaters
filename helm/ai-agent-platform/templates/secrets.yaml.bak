# enterprise-ai-agent-platform/helm/ai-agent-platform/templates/secrets.yaml
apiVersion: v1
kind: Secret
metadata:
  name: {{ include "ai-agent-platform.fullname" . }}-secrets
  labels:
    {{- include "ai-agent-platform.labels" . | nindent 4 }}
type: Opaque
data:
  {{- if .Values.secrets.databaseUrl }}
  database-url: {{ .Values.secrets.databaseUrl | b64enc | quote }}
  {{- else }}
  database-url: {{ printf "postgresql://%s:%s@%s-postgres:%d/%s" .Values.postgresql.auth.username .Values.postgresql.auth.password (include "ai-agent-platform.fullname" .) 5432 .Values.postgresql.auth.database | b64enc | quote }}
  {{- end }}
  
  {{- if .Values.secrets.redisUrl }}
  redis-url: {{ .Values.secrets.redisUrl | b64enc | quote }}
  {{- else }}
  redis-url: {{ printf "redis://default:%s@%s-redis:%d" .Values.redis.auth.password (include "ai-agent-platform.fullname" .) 6379 | b64enc | quote }}
  {{- end }}
  
  {{- if .Values.secrets.mongodbUrl }}
  mongodb-url: {{ .Values.secrets.mongodbUrl | b64enc | quote }}
  {{- else }}
  mongodb-url: {{ printf "mongodb://%s:%s@%s-mongodb:%d/%s" .Values.mongodb.auth.username .Values.mongodb.auth.password (include "ai-agent-platform.fullname" .) 27017 .Values.mongodb.auth.database | b64enc | quote }}
  {{- end }}
  
  jwt-secret: {{ required "JWT secret is required" .Values.secrets.jwtSecret | b64enc | quote }}
  jwt-refresh-secret: {{ required "JWT refresh secret is required" .Values.secrets.jwtRefreshSecret | b64enc | quote }}
  encryption-key: {{ required "Encryption key is required" .Values.secrets.encryptionKey | b64enc | quote }}
  
  openai-api-key: {{ required "OpenAI API key is required" .Values.secrets.openaiApiKey | b64enc | quote }}
  {{- if .Values.secrets.anthropicApiKey }}
  anthropic-api-key: {{ .Values.secrets.anthropicApiKey | b64enc | quote }}
  {{- end }}
  {{- if .Values.secrets.googleAiApiKey }}
  google-ai-api-key: {{ .Values.secrets.googleAiApiKey | b64enc | quote }}
  {{- end }}
  
  google-client-id: {{ required "Google client ID is required" .Values.secrets.googleClientId | b64enc | quote }}
  google-client-secret: {{ required "Google client secret is required" .Values.secrets.googleClientSecret | b64enc | quote }}
  
  {{- if .Values.secrets.linkedinClientId }}
  linkedin-client-id: {{ .Values.secrets.linkedinClientId | b64enc | quote }}
  linkedin-client-secret: {{ .Values.secrets.linkedinClientSecret | b64enc | quote }}
  {{- end }}
  
  {{- if .Values.secrets.facebookAppId }}
  facebook-app-id: {{ .Values.secrets.facebookAppId | b64enc | quote }}
  facebook-app-secret: {{ .Values.secrets.facebookAppSecret | b64enc | quote }}
  {{- end }}
  
  {{- if .Values.secrets.twitterApiKey }}
  twitter-api-key: {{ .Values.secrets.twitterApiKey | b64enc | quote }}
  twitter-api-secret: {{ .Values.secrets.twitterApiSecret | b64enc | quote }}
  {{- end }}
  
  {{- if .Values.secrets.braveSearchApiKey }}
  brave-search-api-key: {{ .Values.secrets.braveSearchApiKey | b64enc | quote }}
  {{- end }}
  
  {{- if .Values.secrets.openweathermapApiKey }}
  openweathermap-api-key: {{ .Values.secrets.openweathermapApiKey | b64enc | quote }}
  {{- end }}
  
  {{- if .Values.secrets.perplexityApiKey }}
  perplexity-api-key: {{ .Values.secrets.perplexityApiKey | b64enc | quote }}
  {{- end }}
  
  stripe-secret-key: {{ required "Stripe secret key is required" .Values.secrets.stripeSecretKey | b64enc | quote }}
  stripe-webhook-secret: {{ required "Stripe webhook secret is required" .Values.secrets.stripeWebhookSecret | b64enc | quote }}
  stripe-publishable-key: {{ required "Stripe publishable key is required" .Values.secrets.stripePublishableKey | b64enc | quote }}
  
  {{- if .Values.secrets.sendgridApiKey }}
  sendgrid-api-key: {{ .Values.secrets.sendgridApiKey | b64enc | quote }}
  {{- end }}
  
  from-email: {{ required "From email is required" .Values.secrets.fromEmail | b64enc | quote }}
